# Copy to .env and fill in for local Postgres testing. Unset DATABASE_URL
# to fall back to local SQLite instead.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon connection string, e.g.:
# postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
